# Local PostgreSQL from compose.yaml only; never commit real credentials.
DATABASE_URL="postgresql://app:app@localhost:5432/cleaning_security?schema=public"
# Integration tests reset data and require a separate local *_test database:
# DATABASE_URL="postgresql://app:app@localhost:5432/cleaning_security_test?schema=public"
# Better Auth: use any random local value of 32+ characters; production must set its own secret.
BETTER_AUTH_SECRET="replace-with-local-random-secret-of-32-plus-chars"
BETTER_AUTH_URL="http://localhost:3000"
